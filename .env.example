# Postgres. No docker-compose o app usa postgres://postgres:wcoen@postgres:5432/wcoen automaticamente.
# Em produção (Supabase), use a "Connection string" do painel do projeto e acrescente ?sslmode=require
# no final (o app só liga TLS quando vê esse parâmetro):
#   postgresql://postgres:SENHA@db.SEUPROJETO.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres:wcoen@localhost:5432/wcoen

# Código que o cliente precisa digitar para se cadastrar no portal (cadastro fechado). Entregue só aos pilotos.
CONVITE=
# 64 caracteres hexadecimais; criptografa as credenciais do WhatsApp no banco. NÃO perca nem troque depois
# (sem ela as sessões gravadas ficam ilegíveis). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAVE_CRIPTO=

# Porta do portal (padrão 3000) e limite de contas conectadas ao mesmo tempo (padrão 20)
PORTA=3000
MAX_SESSOES=20
# Domínio público do portal (ex.: app.seudominio.com.br, ou algo.fly.dev no Fly.io). Com ele o cookie
# passa a ser Secure e o IP é lido do X-Forwarded-For (proxy na frente: Caddy ou o Fly Proxy).
# Em produção, configure DOMINIO: é o que torna confiável o link de redefinição de senha no e-mail.
# Sem ele, o link cai no Host da requisição, que o cliente pode forjar (só é seguro localmente/atrás de HTTPS).
DOMINIO=

# E-mails (já cadastrados no portal) que enxergam /admin e podem criar/revogar convites de cadastro.
# Separados por vírgula. Sem essa variável, ninguém vê a administração.
ADMIN_EMAILS=

# Opcional: comando "auditoria" (dicas da IA). Sem chave, ele responde que a IA não está configurada.
# ATENÇÃO: a auditoria envia valores, datas e descrições dos lançamentos ao OpenRouter, só para os modelos abaixo.
# Use modelos PAGOS (https://openrouter.ai/models), separados por vírgula: o primeiro é o preferido; se falhar, tenta o próximo.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Opcional: e-mail de "esqueci a senha" (nodemailer, SMTP). Sem SMTP_HOST, o link só é logado no
# servidor em vez de enviado — útil em dev. SMTP_PORT default 587; SMTP_FROM default = SMTP_USER.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opcional: e-mail via Resend (API HTTPS). Use no Render gratuito, que bloqueia SMTP. Tem prioridade sobre o SMTP.
# Sem domínio verificado, RESEND_FROM fica no padrão (onboarding@resend.dev) e só envia ao dono da conta Resend.
RESEND_API_KEY=
RESEND_FROM=

# Opcional: conta DEV de recuperação/suporte. Loga pela tela normal de /entrar; some da lista de
# contas do admin; só ela vê o botão de excluir uma conta definitivamente. Trocar DEV_PASSWORD e
# reiniciar já atualiza a senha dessa conta (não precisa lembrar a antiga).
DEV_EMAIL=
DEV_PASSWORD=
