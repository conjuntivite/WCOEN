# Mongo do usuário (Docker). Ajuste usuário/senha se o seu exigir autenticação.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wcoen
# Deixe vazio na primeira execução: o bot lista os grupos e sai. Depois cole aqui o ID (termina em @g.us).
GROUP_ID=
# Opcional: agrupar contas por IA (ex.: "balancete carro" soma gasolina, óleo, mecânico). Sem chave, fica desligado.
# Só os NOMES das contas vão para o OpenRouter. Escolha o modelo em https://openrouter.ai/models
# Modelos separados por vírgula: o primeiro é o preferido (pago); se falhar, tenta o próximo.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Reserva gratuita, tentada depois de OPENROUTER_MODEL. Vazio = lista padrão do código (src/config.ts).
OPENROUTER_FALLBACK_MODELS=
